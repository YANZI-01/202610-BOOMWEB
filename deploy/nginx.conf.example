# Place this server block in your Nginx site configuration.
# Configure your domain, HTTPS certificate and actual dist path before use.
server {
    listen 80;
    server_name example.com;
    root /var/www/boom/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|svg|webp|woff2?)$ {
        try_files $uri =404;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
